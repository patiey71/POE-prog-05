@model EventDetailsViewModel
@{
    var ev = Model.Event;
    ViewData["Title"] = ev.Name;
    var role = Context.Session.GetRole();
    var isOwner = role == SessionUserExtensions.Organiser && ev.OrganiserId == Context.Session.GetUserId();
}
<div class="container">
    <div class="page-head">
        <a asp-action="Index" class="small">&larr; All events</a>
        <h1 class="mt-2">@ev.Name</h1>
    </div>

    <img class="banner-large mb-4" src="@Url.Banner(ev.BannerImage)" alt="Banner for @ev.Name" />

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card-rd p-4">
                <span class="chip @ViewHelpers.ChipClass(ev.EventType)">@ev.EventType</span>
                <p class="mt-3" style="white-space:pre-line">@ev.Description</p>
                <dl class="detail-list row mb-0">
                    <div class="col-sm-6"><dt>Date</dt><dd>@ViewHelpers.LongDate(ev.Date)</dd></div>
                    <div class="col-sm-6"><dt>Location</dt><dd>@ev.Location</dd></div>
                    <div class="col-sm-6"><dt>Distance</dt><dd>@ev.DistanceKm.ToString("0.##") km</dd></div>
                    <div class="col-sm-6"><dt>Organiser</dt><dd>@ev.OrganiserName</dd></div>
                </dl>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card-rd p-4">
                @if (role == SessionUserExtensions.Participant)
                {
                    <h2>Enter this event</h2>
                    @if (Model.MyEnrolment is not null)
                    {
                        <p>You are enrolled in <strong>@Model.MyEnrolment.CategoryName</strong>.</p>
                        <partial name="_StatusBadge" model="Model.MyEnrolment.Status" />
                        <div class="mt-3"><a asp-controller="Enrolments" asp-action="Index">View my enrolments</a></div>
                    }
                    else if (!Model.Categories.Any())
                    {
                        <p class="text-muted mb-0">The organiser has not added any categories yet, so entries are not open.</p>
                    }
                    else
                    {
                        <form asp-action="Enrol" asp-route-id="@ev.Id" method="post">
                            <label class="form-label" for="categoryId">Choose your category</label>
                            <select class="form-select mb-3" id="categoryId" name="categoryId" required>
                                <option value="">Select a category...</option>
                                @foreach (var c in Model.Categories)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-primary">Enrol now</button>
                        </form>
                    }
                }
                else if (isOwner)
                {
                    <h2>Manage</h2>
                    <div class="d-grid gap-2">
                        <a class="btn btn-primary" asp-controller="OrganiserEvents" asp-action="Edit" asp-route-id="@ev.Id">Edit event</a>
                        <a class="btn btn-outline-primary" asp-controller="Categories" asp-action="Index" asp-route-eventId="@ev.Id">Categories</a>
                        <a class="btn btn-outline-primary" asp-controller="OrganiserEnrolments" asp-action="Index" asp-route-eventId="@ev.Id">Enrolments (@ev.EnrolmentCount)</a>
                        <a class="btn btn-outline-primary" asp-controller="ResultsEntry" asp-action="Index" asp-route-eventId="@ev.Id">Capture results</a>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">This event is run by another organiser.</p>
                }
            </div>
        </div>
    </div>
</div>
