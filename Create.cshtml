@model EventFormViewModel
@{
    ViewData["Title"] = "New event";
}
<div class="container">
    <div class="page-head"><h1>New event</h1><p>Tell people what, when and where.</p></div>
    <div class="card-rd form-card">
        <form asp-action="Create" method="post" enctype="multipart/form-data" novalidate>
            <partial name="_EventFields" model="Model" />
            <button class="btn btn-primary mt-4" type="submit">Create event</button>
            <a class="btn btn-link" asp-action="Index">Cancel</a>
        </form>
    </div>
</div>
