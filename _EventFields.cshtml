@model EventFormViewModel
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<div class="row g-3">
    <div class="col-12">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name"></span>
    </div>
    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Date" class="form-label"></label>
        <input asp-for="Date" class="form-control" />
        <span asp-validation-for="Date"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="DistanceKm" class="form-label"></label>
        <input asp-for="DistanceKm" class="form-control" type="number" step="0.01" min="0.01" />
        <span asp-validation-for="DistanceKm"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="EventType" class="form-label"></label>
        <select asp-for="EventType" class="form-select">
            <option value="Run">Run</option>
            <option value="Walk">Walk</option>
            <option value="Cycle">Cycle</option>
        </select>
        <span asp-validation-for="EventType"></span>
    </div>
    <div class="col-12">
        <label asp-for="Location" class="form-label"></label>
        <input asp-for="Location" class="form-control" />
        <span asp-validation-for="Location"></span>
    </div>
    <div class="col-12">
        <label asp-for="Banner" class="form-label">Banner image (optional)</label>
        <div class="d-flex flex-wrap align-items-start gap-3">
            <img id="banner-preview" src="@Url.Banner(Model.ExistingBanner)" alt="Current banner" style="width:220px;aspect-ratio:16/7;object-fit:cover;border-radius:.4rem;background:#0b1b34" />
            <div class="flex-grow-1">
                <input asp-for="Banner" class="form-control" type="file" accept=".jpg,.jpeg,.png,.gif,.webp" data-preview="banner-preview" />
                <div class="form-text">JPG, PNG, GIF or WEBP, up to 5 MB.</div>
                <span asp-validation-for="Banner"></span>
            </div>
        </div>
    </div>
</div>
<input type="hidden" asp-for="ExistingBanner" />
