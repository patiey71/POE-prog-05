@{
    var session = Context.Session;
    var signedIn = session.IsSignedIn();
    var role = session.GetRole();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Active(params string[] names) => names.Contains(controller) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "RaceDay") - RaceDay</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:ital,wght@0,700;0,800;1,800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-raceday" aria-label="Main navigation">
        <div class="container">
            <a class="brand" asp-controller="Home" asp-action="Index">RACE<span>DAY</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto">
                    @if (signedIn && role == SessionUserExtensions.Organiser)
                    {
                        <li class="nav-item"><a class="nav-link @Active("Dashboard")" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link @Active("OrganiserEvents", "Categories", "OrganiserEnrolments", "ResultsEntry")" asp-controller="OrganiserEvents" asp-action="Index">My events</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Events")" asp-controller="Events" asp-action="Index">All events</a></li>
                    }
                    else if (signedIn)
                    {
                        <li class="nav-item"><a class="nav-link @Active("Events")" asp-controller="Events" asp-action="Index">Find an event</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Enrolments")" asp-controller="Enrolments" asp-action="Index">My enrolments</a></li>
                        <li class="nav-item"><a class="nav-link @Active("MyResults")" asp-controller="MyResults" asp-action="Index">My results</a></li>
                    }
                </ul>
                <ul class="navbar-nav align-items-lg-center gap-lg-2">
                    @if (signedIn)
                    {
                        <li class="nav-item">
                            <a class="nav-link nav-user p-0 me-lg-2" asp-controller="Profile" asp-action="Index" title="My profile">
                                <img src="@Url.Avatar(session.GetPicture())" alt="" />
                                <span>@session.GetDisplayName()</span>
                                <span class="role-pill">@role</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-light">Log out</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link @Active("Account")" asp-controller="Account" asp-action="Login">Log in</a></li>
                        <li class="nav-item"><a class="btn btn-volt btn-sm" asp-controller="Account" asp-action="Register">Join RaceDay</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>

<main>
    <div class="container">
        <partial name="_Alerts" />
    </div>
    @RenderBody()
</main>

<footer class="site-footer">
    <div class="container d-flex flex-wrap justify-content-between gap-2">
        <span><span class="brand-small">RaceDay</span> &middot; Run it. Walk it. Ride it.</span>
        <span>&copy; @DateTime.Now.Year RaceDay</span>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
<script src="~/js/site.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
