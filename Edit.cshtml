@model EventFormViewModel
@{
    ViewData["Title"] = "Edit event";
}
<div class="container">
    <div class="page-head"><h1>Edit event</h1><p>@Model.Name</p></div>
    <div class="card-rd form-card">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" novalidate>
            <partial name="_EventFields" model="Model" />
            <button class="btn btn-primary mt-4" type="submit">Save changes</button>
            <a class="btn btn-link" asp-action="Index">Cancel</a>
        </form>
    </div>
</div>
